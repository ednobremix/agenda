# Configurações de Banco de Dados
# Se DATABASE_URL estiver definida, o sistema usará PostgreSQL (prioridade)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Se DATABASE_URL não estiver definida, o sistema usará SQLite local
# Defina SQLITE_DB para mudar o nome do arquivo do banco (padrão: sqlite.db)
# SQLITE_DB=meu_app.db

